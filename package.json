{
  "name": "jiajia-mcp",
  "version": "0.1.0",
  "description": "夹夹 MCP 的工具定义和本地 stdio 转发：把 stdio 上的 MCP 请求转发到 https://jiajia.fun/mcp",
  "mcpName": "io.github.Joye-Co/jiajia-mcp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joye-Co/jiajia-mcp.git"
  },
  "homepage": "https://jiajia.fun",
  "bugs": {
    "url": "https://github.com/Joye-Co/jiajia-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "jiajia",
    "stdio",
    "agent"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "jiajia-mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/*.json": "./schema/*.json"
  },
  "files": [
    "dist",
    "schema",
    "LICENSE-CONTENT"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "node --test \"test/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "schema:build": "node scripts/build-schema.ts",
    "check:schema": "node scripts/build-schema.ts --check",
    "check:compat": "node scripts/schema-compat.ts",
    "check:contract": "node scripts/check-contract.ts",
    "check:pack": "node scripts/check-pack.ts",
    "smoke:dist": "node scripts/smoke-dist.mjs",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "validate:server-json": "node scripts/validate-server-json.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^24",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "~6.0.3"
  }
}
