{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Joye-Co/jiajia-mcp",
  "title": "夹夹",
  "description": "登录后检索和阅读夹夹（jiajia.fun）的群聊问答、答案、面经和日报周报，也可以直接问夹夹",
  "repository": {
    "url": "https://github.com/Joye-Co/jiajia-mcp",
    "source": "github"
  },
  "websiteUrl": "https://jiajia.fun",
  "version": "0.1.0",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://jiajia.fun/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "格式为 Bearer <key>，key 在 jiajia.fun 登录后生成。不填时客户端要支持 OAuth 登录，否则服务端返回 401",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "jiajia-mcp",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "JIAJIA_MCP_KEY",
          "description": "jiajia.fun 登录后生成的 key；不设置时服务端返回 401",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
